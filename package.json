{
  "name": "tp-reveil-musical",
  "version": "1.0.0",
  "description": "Wake-up service that picks a track from the weather and notifies the user on their preferred channel",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "licenses": "node scripts/license-report.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EMA-MAYEUL/tp-reveil-musical.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "awilix": "^13.0.5",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
